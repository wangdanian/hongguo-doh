# /etc/cron.d/hongguo-autodetect  （注意 /etc/cron.d 格式必须有 user 字段）
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

*/30 * * * * root flock -n /tmp/autodetect.lock /usr/bin/python3 /opt/hongguo-doh/autodetect.py >> /opt/hongguo-doh/autodetect.log 2>&1
# 无人值守广告反馈归因：每 5 分钟扫最近 6 分钟放行日志，确凿广告域自动写精确域规则
*/5 * * * * root flock -n /tmp/auto-feedback.lock /usr/bin/python3 /opt/hongguo-doh/ad_feedback.py --auto >/dev/null 2>>/opt/hongguo-doh/auto-feedback-err.log
# 广告命名特征体检 + 自动归纳：每天回放日志，护栏全过才晋升新特征
# （业务域 0 误伤 / 强广告标记 / 白名单父域跳过 / 仅新增覆盖 / 每次 2 条、每天 10 条）
10 4 * * * root flock -n /tmp/signature-report.lock /usr/bin/python3 /opt/hongguo-doh/signature_report.py --auto >> /opt/hongguo-doh/signature-report.log 2>&1
