# 复制为 .env 后按实际情况修改（.env 已被 .gitignore 排除）。
# 示例地址 203.0.113.10 是 RFC 5737 文档地址，仅用于占位，请换成你的公网 IP 或域名。

# ---------- 服务本体（src/doh_server.py 读取） ----------
# 对外地址：生成描述文件时写进 ServerURL / WebClip URL / 安装页
DOH_BASE_URL=https://203.0.113.10

# 监听地址与端口（nginx 反代到 127.0.0.1:5053）
DOH_LISTEN_IP=127.0.0.1
DOH_LISTEN_PORT=5053

# 上游 DNS，逗号分隔；可带端口，IPv6 用方括号
HONGGUO_UPSTREAM=223.5.5.5,119.29.29.29:53,114.114.114.114

# ---------- 日志（src/watch.py 读取） ----------
WATCH_KEEP_DAYS=30

# ---------- 可选：阿里云 ECS 云助手运维工具 ----------
# 只在用 tools/ecs_run.py / push_file.py / fetch_file.py 时需要。
# 也可用项目之外的用户级私有文件 ~/.workbuddy/private/ecs_secrets.json
# （用 ECS_SECRETS_FILE 改路径，权限设为仅当前用户可读）。
# 不要把带值的凭据文件放进任何仓库目录；.env 本身也不入库。
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIYUN_REGION=cn-hangzhou
ALIYUN_INSTANCE_ID=

# ---------- 可选：部署脚本用 ----------
# 证书安装目录 / 部署根目录
DEPLOY_DIR=/opt/hongguo-doh
TLS_CERT=/etc/nginx/tls/fullchain.pem
TLS_KEY=/etc/nginx/tls/key.pem
